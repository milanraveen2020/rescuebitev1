auto-install-peers=true
shamefully-hoist=false
strict-peer-dependencies=false
node-linker=isolated
# Shorten node_modules/.pnpm/* dir names so deep native (CMake/NDK) build paths
# stay under Windows' 260-char / CMake's 250-char limits. Critical for building
# the customer dev client on Windows — see CLAUDE.md "Windows host build". If you
# change this, delete node_modules and re-run pnpm install.
virtual-store-dir-max-length=40
