# RescueBite — Customer mobile app (Expo)
# Copy to .env. Expo exposes EXPO_PUBLIC_* vars to the JS bundle, and
# app.config.ts feeds EXPO_PUBLIC_API_BASE_URL into expo.extra.apiBaseUrl.

# Base URL of the RescueBite API. Optional — leave unset to use the default
# baked into app.json (http://10.0.2.2:4000, the host loopback for the Android
# emulator). Set this only to override, e.g. a physical device on your LAN:
#   EXPO_PUBLIC_API_BASE_URL=http://192.168.1.50:4000
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:4000
